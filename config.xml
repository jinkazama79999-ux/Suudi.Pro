1. Tiga Masalah Utama pada build.yml Anda Sebelumnya
Karakter Spasi Tak Terlihat (Non-Breaking Space) di Awal Baris YAML
Sama seperti pada config.xml tadi, banyak baris indentasi di build.yml Anda mengandung karakter spasi khusus (\u00A0) hasil salin-tempel dari perangkat mobile. Parser YAML di GitHub Actions langsung menolak indentasi tersebut dan membatalkan workflow (✕).

Perintah cordova plugin add Belum Dipanggil di build.yml
Pada Cordova versi terbaru (npm install -g cordova menginstal Cordova 12), perintah cordova platform add android hanya membaca daftar plugin dari package.json hasil cordova create, bukan dari <plugin> di config.xml. Akibatnya, tidak ada satu pun plugin yang ikut terpasang ke dalam APK.

Konflik cordova-plugin-printer Lawas dengan JDK 17 & Android SDK Baru
Plugin cordova-plugin-printer (^0.8.0) dibuat untuk Android versi lama (android.support.v4). Ketika dikompilasi menggunakan JDK 17 di GitHub Actions (Cordova Android 12/13), Gradle akan gagal kompilasi karena pustaka android.support.v4 sudah dihapus oleh Google dan digantikan oleh AndroidX + android.print.PrintManager bawaan sistem.

2. Solusi Permanen di .github/workflows/build.yml (Tanpa Plugin Lawas yang Rawan Error)
Agar proses build APK di GitHub Actions selalu berhasil centang hijau (✓) sekaligus membuat tombol Cetak PDF, Unduh Excel (.xls), Ekspor CSV, dan Simpan Gambar Laporan (.png) langsung menyimpan berkas ke Folder Download HP Android (Android 8 s/d Android 15), saya telah menyertakan penyuntik jembatan native (SuudiAndroidBridge) langsung ke MainActivity.java di dalam build.yml di bawah ini:

window.Android.printHtml(): Memanggil android.print.PrintManager resmi bawaan Android untuk membuka layar Simpan sebagai PDF / Cetak.

window.Android.saveFileToDownloads(): Memanggil MediaStore.Downloads resmi Android 10–15 untuk menulis berkas .xls (Excel), .csv, dan .png langsung ke Folder Download HP tanpa terblokir izin Scoped Storage.

Silakan ganti seluruh isi .github/workflows/build.yml Anda di GitHub dengan kode bersih berikut:

YAML
name: Build Android APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Cordova Global
        run: npm install -g cordova

      - name: Create Cordova Project & Configure Android
        run: |
          cordova create myApp com.suudi.pro SuudiPro
          cd myApp

          # Bersihkan karakter non-breaking space pada config.xml jika ada, dan hapus plugin printer lawas yang bikin gagal Gradle
          if [ -f ../config.xml ]; then
            sed 's/\xc2\xa0/ /g' ../config.xml | grep -v "cordova-plugin-printer" > config.xml
          fi

          if [ -f ../icon.png ]; then
            cp ../icon.png icon.png
          fi

          # Tambahkan plugin resmi Cordova untuk Kamera & Sistem Berkas
          cordova plugin add cordova-plugin-file
          cordova plugin add cordova-plugin-camera
          cordova platform add android

      - name: Inject Native Android PDF Printer & Download Saver Bridge
        run: |
          MAIN_ACTIVITY_PATH=$(find myApp/platforms/android/app/src/main/java -name "MainActivity.java" | head -n 1)
          echo "Patching MainActivity at: $MAIN_ACTIVITY_PATH"
          cat << 'EOF' > "$MAIN_ACTIVITY_PATH"
          package com.suudi.pro;

          import android.content.ContentValues;
          import android.content.Context;
          import android.net.Uri;
          import android.os.Build;
          import android.os.Bundle;
          import android.os.Environment;
          import android.print.PrintAttributes;
          import android.print.PrintDocumentAdapter;
          import android.print.PrintManager;
          import android.provider.MediaStore;
          import android.util.Base64;
          import android.webkit.JavascriptInterface;
          import android.webkit.WebView;
          import android.webkit.WebViewClient;
          import android.widget.Toast;
          import java.io.File;
          import java.io.FileOutputStream;
          import java.io.OutputStream;
          import org.apache.cordova.*;

          public class MainActivity extends CordovaActivity {
              private WebView printWebView;

              @Override
              public void onCreate(Bundle savedInstanceState) {
                  super.onCreate(savedInstanceState);
                  Bundle extras = getIntent().getExtras();
                  if (extras != null && extras.getBoolean("cdvStartInBackground", false)) {
                      moveTaskToBack(true);
                  }
                  loadUrl(launchUrl);

                  try {
                      if (this.appView != null && this.appView.getView() instanceof WebView) {
                          WebView webView = (WebView) this.appView.getView();
                          webView.getSettings().setJavaScriptEnabled(true);
                          webView.addJavascriptInterface(new SuudiAndroidBridge(this), "Android");
                      }
                  } catch (Exception e) {
                      e.printStackTrace();
                  }
              }

              public class SuudiAndroidBridge {
                  private final Context ctx;

                  public SuudiAndroidBridge(Context context) {
                      this.ctx = context;
                  }

                  @JavascriptInterface
                  public void printHtml(final String htmlContent, final String jobName) {
                      runOnUiThread(new Runnable() {
                          @Override
                          public void run() {
                              try {
                                  WebView webView = new WebView(MainActivity.this);
                                  webView.setWebViewClient(new WebViewClient() {
                                      @Override
                                      public void onPageFinished(WebView view, String url) {
                                          PrintManager printManager = (PrintManager) getSystemService(Context.PRINT_SERVICE);
                                          String docName = (jobName != null && !jobName.isEmpty()) ? jobName : "Laporan_SuudiPro";
                                          PrintDocumentAdapter adapter = view.createPrintDocumentAdapter(docName);
                                          if (printManager != null) {
                                              printManager.print(docName, adapter, new PrintAttributes.Builder().build());
                                          }
                                          printWebView = null;
                                      }
                                  });
                                  printWebView = webView;
                                  webView.loadDataWithBaseURL(null, htmlContent, "text/HTML", "UTF-8", null);
                              } catch (Exception e) {
                                  Toast.makeText(ctx, "Gagal membuka cetak PDF: " + e.getMessage(), Toast.LENGTH_LONG).show();
                              }
                          }
                      });
                  }

                  @JavascriptInterface
                  public void printPage() {
                      runOnUiThread(new Runnable() {
                          @Override
                          public void run() {
                              try {
                                  if (appView != null && appView.getView() instanceof WebView) {
                                      WebView wv = (WebView) appView.getView();
                                      PrintManager pm = (PrintManager) getSystemService(Context.PRINT_SERVICE);
                                      if (pm != null) {
                                          pm.print("Laporan_SuudiPro", wv.createPrintDocumentAdapter("Laporan_SuudiPro"), new PrintAttributes.Builder().build());
                                      }
                                  }
                              } catch (Exception e) {}
                          }
                      });
                  }

                  @JavascriptInterface
                  public boolean saveFileToDownloads(String base64Data, final String fileName, String mimeType) {
                      try {
                          String cleanBase64 = base64Data;
                          int commaIndex = base64Data.indexOf(',');
                          if (commaIndex != -1) {
                              cleanBase64 = base64Data.substring(commaIndex + 1);
                          }
                          byte[] bytes = Base64.decode(cleanBase64, Base64.DEFAULT);
                          String safeMime = (mimeType != null && !mimeType.isEmpty()) ? mimeType : "application/octet-stream";

                          if (Build.VERSION.SDK_INT >= 29) {
                              ContentValues values = new ContentValues();
                              values.put(MediaStore.Downloads.DISPLAY_NAME, fileName);
                              values.put(MediaStore.Downloads.MIME_TYPE, safeMime);
                              values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
                              Uri uri = getContentResolver().insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
                              if (uri != null) {
                                  OutputStream os = getContentResolver().openOutputStream(uri);
                                  if (os != null) {
                                      os.write(bytes);
                                      os.flush();
                                      os.close();
                                  }
                              }
                          } else {
                              File dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
                              if (!dir.exists()) dir.mkdirs();
                              File outFile = new File(dir, fileName);
                              FileOutputStream fos = new FileOutputStream(outFile);
                              fos.write(bytes);
                              fos.flush();
                              fos.close();
                          }

                          runOnUiThread(new Runnable() {
                              @Override
                              public void run() {
                                  Toast.makeText(ctx, "Tersimpan di folder Download: " + fileName, Toast.LENGTH_LONG).show();
                              }
                          });
                          return true;
                      } catch (final Exception e) {
                          runOnUiThread(new Runnable() {
                              @Override
                              public void run() {
                                  Toast.makeText(ctx, "Gagal menyimpan file: " + e.getMessage(), Toast.LENGTH_LONG).show();
                              }
                          });
                          return false;
                      }
                  }
              }
          }
          EOF

      - name: Copy Web Files
        run: |
          rm -rf myApp/www/*
          cp index.html myApp/www/index.html
          for dir in css js assets; do
            if [ -d "$dir" ]; then
              cp -r "$dir" myApp/www/
            fi
          done

      - name: Build APK Debug
        run: |
          cd myApp
          cordova build android --debug

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-debug-apk
          path: myApp/platforms/android/app/build/outputs/apk/debug/app-debug.apk
