<?xml version='1.0' encoding='utf-8'?>
<widget id="com.suudi.pro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>SuudiPro</name>
    <description>Aplikasi HTML to APK Buatan Sendiri</description>
    <author email="dev@suudi.pro" href="https://suudi.pro">Suudi Developer</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- Pengaturan Preferensi untuk WebView Android -->
    <preference name="MixedContentMode" value="compatibility" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    
    <!-- Pengaturan Platform Android (Izin & Fitur) -->
    <platform name="android">
        <icon src="icon.png" />
        
        <!-- Menambahkan Izin Sistem agar tidak kosong -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
        </edit-config>
    </platform>
</widget>
