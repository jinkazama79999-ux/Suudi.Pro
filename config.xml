<?xml version="1.0" encoding="utf-8"?>
<widget id="com.suudi.pro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>SuudiPro</name>
    <description>Aplikasi Manajemen Keuangan Multi-Proyek Suudi.Pro</description>
    <author email="dev@suudi.pro" href="https://suudi.pro">Suudi Developer</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="AndroidXEnabled" value="true" />
    <preference name="MixedContentMode" value="compatibility" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="AllowUntrustedCerts" value="true" />
    <preference name="Fullscreen" value="false" />
    <preference name="AndroidExtraFilesystems" value="files,files-external,documents,sdcard,cache,cache-external,assets,root" />

    <plugin name="cordova-plugin-file" spec="^8.0.0" />
    <plugin name="cordova-plugin-camera" spec="^7.0.0" />

    <platform name="android">
        <icon src="icon.png" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#050816" />
        <preference name="AutoHideSplashScreen" value="true" />
    </platform>
</widget>
